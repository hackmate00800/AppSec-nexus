{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppSec Nexus",
  "version": "0.1.0",
  "identifier": "com.appsec.nexus",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AppSec Nexus - Cybersecurity & Web Pentesting",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
