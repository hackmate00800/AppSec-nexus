# AppSec Nexus Environment Configuration Template
# Placeholders only - Never commit real credentials, tokens, or private keys.

# Port for local development frontend Vite server (default: 1420)
VITE_PORT=1420

# Host binding for development
VITE_HOST=127.0.0.1

# Ollama inference endpoint (offline local default)
OLLAMA_HOST=http://127.0.0.1:11434

# Security boundary overrides (TESTING ONLY - Keep false in production)
ALLOW_PRIVATE_RANGES_UNSAFE=false
DEBUG_LOG_LEVEL=info

# DeepSeek Cloud AI Provider (Optional Remote Model Integration)
# Official documentation: https://api-docs.deepseek.com/
# Obtain your key at: https://platform.deepseek.com/api_keys
# IMPORTANT: Never commit your actual key to git!
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_ENABLED=true
